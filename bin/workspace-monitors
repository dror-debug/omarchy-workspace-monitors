#!/bin/bash
# Workspace → monitor rules for the drorko.workspace-monitors panel.
#
#   workspace-monitors state                 JSON for the panel: monitors, workspaces, windows, rules
#   workspace-monitors set <ws> <monitor>    pin a workspace to a monitor and move it there now
#   workspace-monitors star <ws> <monitor>   make it the workspace that monitor shows on connect
#   workspace-monitors apply                 re-render the Lua file and push every rule live
#   workspace-monitors import <rules-json>   seed the store, e.g. from another tool's rules
#   workspace-monitors install-launcher      write the Super+Space launcher entry
#
# A monitor is named by "desc:<description>", not by its connector, so a rule
# follows the screen rather than whichever port it is plugged into.

set -uo pipefail

store=${WSMON_STORE:-$HOME/.config/omarchy/workspace-monitors.json}
lua=${WSMON_LUA:-$HOME/.config/hypr/workspace-monitors.lua}

die() { echo "workspace-monitors: $*" >&2; exit 1; }

rules() { [[ -f $store ]] && jq -c '.rules // {}' "$store" 2>/dev/null || echo '{}'; }

save_rules() {
  local tmp
  mkdir -p "${store%/*}"
  tmp=$(mktemp "$store.XXXXXX") || die "cannot write $store"
  jq -n --argjson r "$1" '{ rules: $r }' >"$tmp" && mv -f "$tmp" "$store"
}

valid_ws() { [[ $1 =~ ^[0-9]+$ ]] && (( $1 >= 1 && $1 <= 10 )) || die "workspace must be 1-10: $1"; }

lua_rule() {
  # $1 workspace, $2 monitor key, $3 true|false
  printf 'hl.workspace_rule({ workspace = "%s", monitor = %s, default = %s })' \
    "$1" "$(jq -rn --arg m "$2" '$m | @json')" "$3"
}

render() {
  local r tmp
  r=$(rules)
  mkdir -p "${lua%/*}"
  tmp=$(mktemp "$lua.XXXXXX") || die "cannot write $lua"
  {
    echo "-- Generated by drorko.workspace-monitors. Change it from the panel (SUPER+CTRL+M),"
    echo "-- not by hand: the next change there rewrites this file."
    # One field per line on purpose: OmaSettings reads single-line
    # hl.workspace_rule calls as its own and comments them out on remove.
    jq -r 'to_entries | sort_by(.key | tonumber) | .[] | [.key, .value.monitor, (.value.default // false | tostring)] | @tsv' <<<"$r" |
      while IFS=$'\t' read -r ws mon def; do
        printf 'hl.workspace_rule({\n  workspace = "%s",\n  monitor = %s,\n  default = %s,\n})\n' \
          "$ws" "$(jq -rn --arg m "$mon" '$m | @json')" "$def"
      done
  } >"$tmp"
  if command -v luac >/dev/null && ! luac -p "$tmp" 2>/dev/null; then
    rm -f "$tmp"; die "generated Lua does not compile"
  fi
  mv -f "$tmp" "$lua"
}

push_rule() {
  # Rules are keyed by workspace in Hyprland, so evaluating one again replaces it.
  hyprctl eval "$(lua_rule "$1" "$2" "$3")" >/dev/null 2>&1
}

workspace_exists() { hyprctl workspaces -j | jq -e --argjson id "$1" 'any(.[]; .id == $id)' >/dev/null; }

# Whether Hyprland's config loads the generated file, so rules outlive a restart.
loaded() {
  grep -qsE '^[[:space:]]*require\(["'"'"']hypr\.workspace-monitors["'"'"']\)' "${HYPR_CONFIG:-$HOME/.config/hypr/hyprland.lua}" &&
    echo true || echo false
}

state() {
  local laptop
  laptop=$(omarchy-hyprland-monitor-laptop 2>/dev/null || true)
  jq -n \
    --argjson monitors "$(hyprctl monitors -j)" \
    --argjson workspaces "$(hyprctl workspaces -j)" \
    --argjson clients "$(hyprctl clients -j)" \
    --argjson rules "$(rules)" \
    --arg laptop "$laptop" \
    --argjson loaded "$(loaded)" '
    def key: if (.description // "") != "" then "desc:" + .description else .name end;
    {
      monitors: [ $monitors[] | select(.disabled | not) | {
        name, key: key, description, x,
        laptop: (if $laptop != "" then .name == $laptop else (.name | test("^(eDP|LVDS|DSI)")) end),
        focused, activeWorkspace: .activeWorkspace.id
      } ] | sort_by(.x),
      workspaces: [ $workspaces[] | select(.id > 0) | { id, monitor } ],
      windows: [ $clients[] | select(.workspace.id > 0 and .mapped) | { workspace: .workspace.id, class } ],
      rules: $rules,
      loaded: $loaded
    }'
}

cmd_set() {
  local ws=$1 mon=$2 r
  valid_ws "$ws"; [[ -n $mon ]] || die "missing monitor"
  # A workspace leaving a monitor stops being that monitor's default.
  r=$(rules | jq -c --arg ws "$ws" --arg m "$mon" '
    .[$ws] = { monitor: $m, default: ((.[$ws].monitor == $m) and (.[$ws].default // false)) }')
  save_rules "$r"
  render
  push_rule "$ws" "$mon" "$(jq -r --arg ws "$ws" '.[$ws].default' <<<"$r")"
  if workspace_exists "$ws"; then
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$ws\", monitor = $(jq -rn --arg m "$mon" '$m | @json') })" >/dev/null 2>&1
  fi
}

cmd_star() {
  local ws=$1 mon=$2 r
  valid_ws "$ws"; [[ -n $mon ]] || die "missing monitor"
  r=$(rules | jq -c --arg ws "$ws" --arg m "$mon" '
    with_entries(if .value.monitor == $m then .value.default = false else . end)
    | .[$ws] = { monitor: $m, default: true }')
  save_rules "$r"
  render
  jq -r --arg m "$mon" 'to_entries[] | select(.value.monitor == $m) | [.key, (.value.default | tostring)] | @tsv' <<<"$r" |
    while IFS=$'\t' read -r w d; do push_rule "$w" "$mon" "$d"; done
}

cmd_apply() {
  render
  rules | jq -r 'to_entries[] | [.key, .value.monitor, (.value.default // false | tostring)] | @tsv' |
    while IFS=$'\t' read -r ws mon def; do push_rule "$ws" "$mon" "$def"; done
}

cmd_import() {
  local r
  r=$(jq -c 'with_entries(select(.value.monitor != null and .value.monitor != "")
             | .value = { monitor: .value.monitor, default: (.value.default // false) })' <<<"$1") ||
    die "import expects a JSON object of rules"
  save_rules "$r"
  cmd_apply
}

cmd_install_launcher() {
  local dest=$HOME/.local/share/applications/workspace-monitors.desktop tmp
  # Never overwrite an entry someone else wrote at this path.
  if [[ -e $dest ]] && ! grep -q '^X-WorkspaceMonitors-Managed=true$' "$dest"; then return 0; fi
  mkdir -p "${dest%/*}"
  tmp=$(mktemp "$dest.XXXXXX") || return 1
  cat >"$tmp" <<EOF
[Desktop Entry]
Type=Application
Name=Workspace Monitors
GenericName=Workspaces to monitors
Comment=Choose which monitor holds each workspace
Exec=omarchy-shell shell toggle drorko.workspace-monitors
TryExec=omarchy-shell
Icon=video-display
Terminal=false
StartupNotify=false
Categories=Settings;DesktopSettings;
Keywords=workspace;monitor;display;screen;hyprland;
X-WorkspaceMonitors-Managed=true
EOF
  chmod 644 "$tmp"
  if cmp -s "$tmp" "$dest"; then rm -f "$tmp"; else mv -f "$tmp" "$dest"; fi
}

case "${1:-}" in
  state) state ;;
  set) cmd_set "${2:-}" "${3:-}" ;;
  star) cmd_star "${2:-}" "${3:-}" ;;
  apply) cmd_apply ;;
  import) cmd_import "${2:-}" ;;
  install-launcher) cmd_install_launcher ;;
  *) die "usage: workspace-monitors state | set <ws> <monitor> | star <ws> <monitor> | apply | import <json> | install-launcher" ;;
esac
